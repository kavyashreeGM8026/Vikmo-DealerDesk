# Copy this file to .env and fill in your own values.
# Never commit .env or put real secrets in this file: placeholders only.

# Local development only: uncomment for detailed error pages.
# The code defaults to 0 (off) when this is not set, which is what the grader uses.
# DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-secret-key

# PostgreSQL only (SQLite is not allowed).
# If the password has special characters, URL-encode them (@ = %40, # = %23, / = %2F).
# For a hosted database (Neon, Supabase) you usually need ?sslmode=require at the end.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dealerdesk

SUPPLIER_API_URL=http://127.0.0.1:8099
SUPPLIER_API_KEY=replace-with-supplier-key

# Gemini API key for the dealer assistant.
GEMINI_API_KEY=replace-with-your-gemini-api-key
